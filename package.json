{
  "name": "coach-motion-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts CoachAd out/coach-ad.mp4 --codec h264",
    "render:still": "remotion still src/index.ts CoachAd out/poster.png --frame 120",
    "check": "tsc --noEmit",
    "media:prep": "bash scripts/prepare-footage.sh"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.7.3"
  }
}
